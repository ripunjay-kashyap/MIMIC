# Copy to backend/.env and fill in. Never commit .env.
# The same names go into Hugging Face Space → Settings → Variables and secrets.

# ---------------------------------------------------------------- Supabase  [SECRET]
# Project Settings → API Keys. Use a SECRET key (sb_secret_...) or legacy service_role — NOT the publishable key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------- Groq  [SECRET]
GROQ_API_KEY=
# Spillover pool for decisions (any order).
GROQ_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-120b,openai/gpt-oss-20b
# Pinned decision model per persona group: [power+impatient, cautious+chaos, low_literacy+explorer]
DECISION_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-120b,gemini-3.5-flash-lite

# ---------------------------------------------------------------- Gemini  [SECRET]
# One key per Google project, comma-separated, no spaces.
GEMINI_API_KEYS=
GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash-lite

# ---------------------------------------------------------------- LangSmith (optional)  [SECRET]
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mimic

# ---------------------------------------------------------------- Modes
# real | fake  (fake = scripted LLM, zero quota; use for dev/tests)
LLM_MODE=real
GEMINI_MODE=fake

# ---------------------------------------------------------------- HTTP / CORS
# Exact origins, comma-separated. *.vercel.app is also allowed via CORS_ORIGIN_REGEX.
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------- Targets / safety
# Local dev: true. Production (Modal) sets false (blocks localhost/private IP targets).
ALLOW_LOCAL_TARGETS=true
# Hosts where "risky" actions (e.g. pay) are allowed — only our own demo site.
# Local: localhost,127.0.0.1   Modal: set in modal_app.py
DEMO_TARGET_HOSTS=localhost,127.0.0.1
# Empty = any public host allowed (still requires the "authorized" checkbox).
ALLOWED_TARGET_HOSTS=

# ---------------------------------------------------------------- Runtime
MAX_CONCURRENT_PERSONAS=6
# key | all | none
SCREENSHOT_MODE=key
